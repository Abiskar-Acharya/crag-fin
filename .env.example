# Optional fallback search:
# BRAVE_API_KEY=
# SERPER_API_KEY=

# === Finance APIs ===
SEC_EDGAR_USER_AGENT="Abiskar Acharya - Research - abiskaracharya1@gmail.com"
COMPANIES_HOUSE_API_KEY=your_companies_house_key
FCA_REGISTER_API_KEY=optional_fca_key

# === LLM APIs (fallback for local) ===
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
