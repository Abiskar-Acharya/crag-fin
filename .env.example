# Copy to .env and fill in. Never commit .env.

# === Web search ===
TAVILY_API_KEY=your_tavily_key_here
# Optional fallback search:
# BRAVE_API_KEY=
# SERPER_API_KEY=

# === Finance APIs ===
SEC_EDGAR_USER_AGENT="Abiskar Acharya - Research - abiskaracharya1@gmail.com"
COMPANIES_HOUSE_API_KEY=your_companies_house_key
FCA_REGISTER_API_KEY=optional_fca_key

# === LLM APIs (fallback for local) ===
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GEMINI_API_KEY=
KIMI_API_KEY=
MINIMAX_API_KEY=
# Banned for cost during prototype; uncomment only for ablation:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# === Ollama (local; default port) ===
OLLAMA_HOST=http://localhost:11434
OLLAMA_DECOMPOSER_MODEL=qwen2.5:7b
OLLAMA_REASONER_MODEL=glm-4.7-flash:latest
OLLAMA_AUDITOR_MODEL=hermes3:8b
OLLAMA_SMOKE_TEST_MODEL=qwen3:4b

# === ChromaDB (local) ===
CHROMA_PERSIST_DIR=./chroma_db

# === Day 1: external substrates ===
# CN6000 RoBERTa baseline checkpoint (~/Projects/fake_news_detection/model0.pth)
ROBERTA_CN6000_PATH=/Users/abiskaracharya/Projects/fake_news_detection/model0.pth
# ArXivMind chroma persist dir (read-only reuse)
ARXIVMIND_CHROMA_DIR=/Users/abiskaracharya/ai-projects/glm-rag-pipeline/data
ARXIVMIND_COLLECTION=research_papers
ARXIVMIND_EMBEDDING_MODEL=all-MiniLM-L6-v2
# Path to the glm-rag-pipeline repo (for sys.path import of HybridRetriever)
ARXIVMIND_REPO=/Users/abiskaracharya/ai-projects/glm-rag-pipeline

# === Day 2: financial-news seed index (separate chroma collection) ===
NEWS_CHROMA_DIR=./chroma_db/finance_news
NEWS_COLLECTION=crag_fin_news_v0
RSS_FEEDS_CONFIG=configs/rss_feeds.yaml

# === Conformal ===
CONFORMAL_ALPHA=0.10
CONFORMAL_FN_FP_RATIO=5

# === Eval ===
RESULTS_DIR=./experiments/results
RUNS_DIR=./experiments/runs
